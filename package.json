{
  "name": "white-lab-logic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "node scripts/validate-data.mjs && vitepress build docs",
